# OOJOO FARM — 에뮬레이터 자동반영 설정 (Linux 호스트)
# 이 파일을 소스로 사용하는 스크립트: emulator-up.sh / sync-apps.sh / watch.sh
#
# 주의: 이 호스트는 KVM 없음 (EC2, vmx/svm 미지원) → QEMU TCG 소프트웨어
# 에뮬레이션 (ANDROID_I_WANT_MY_TCG) 강제. 첫 부팅 10~30분, 실행은 느림.

ANDROID_HOME="${ANDROID_HOME:-$HOME/tools/android-sdk}"
EMULATOR_BIN="$ANDROID_HOME/emulator/emulator"
AVD_NAME="${AVD_NAME:-oojoo-api34}"
EMU_ACCEL="${EMU_ACCEL:-off}"
# ADB 포트 고정 (기본 5555 슬롯은 이 호스트의 nv-hostengine(root, NVIDIA DCGM)이
# 점유 중이라 8989 사용) — emulator-8989 로 adb 에 표시
EMU_PORT="${EMU_PORT:-8989}"
EMU_SERIAL="emulator-$EMU_PORT"
# adb 호출은 항상 세리얼 명시 (-s). 강제 종료한 에뮬레이터의 유령 transport
# (예: emulator-5554)가 adb 서버에 남는 경우가 있어서, bare adb는
# "more than one device" 로 실패한다.
# 호출처가 "$ADB" 변수 형태로 쓰기 때문에 함수명을 변수에 보관
# (bash 명령 조회가 함수명을 해석).
_adb_serial() { "$ANDROID_HOME/platform-tools/adb" -s "$EMU_SERIAL" "$@"; }
ADB="_adb_serial"
EMU_EXTRA_FLAGS=(-no-window -no-audio -no-boot-anim -cores 8 -memory 4096 -gpu swiftshader_indirect)

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/../.." && pwd)"
ANDROID_DIR="$REPO_ROOT/android"
BACKEND_DIR="$REPO_ROOT/backend"

MASTER_PKG="com.oojoo.farm.master"
SLAVE_PKG="com.oojoo.farm.slave"
MASTER_APK="$ANDROID_DIR/master/app/build/outputs/apk/debug/app-debug.apk"
SLAVE_APK="$ANDROID_DIR/slave/app/build/outputs/apk/debug/app-debug.apk"

PORT="${PORT:-4000}"
SERVER_URL="http://10.0.2.2:$PORT/"
NODE_BIN="$HOME/.local/oojoo-task1/node-v22/bin"
JAVA_HOME_FOR_BUILD="${JAVA_HOME_FOR_BUILD:-/usr/lib/jvm/java-21-amazon-corretto}"

RUN_DIR="$REPO_ROOT/.dev-run"
BACKEND_PIDFILE="$RUN_DIR/backend.pid"
EMULATOR_PIDFILE="$RUN_DIR/emulator.pid"
WATCH_PIDFILE="$RUN_DIR/emulator-watch.pid"
BACKEND_LOG="$RUN_DIR/backend.log"
EMULATOR_LOG="$RUN_DIR/emulator.log"
WATCH_LOG="$RUN_DIR/emulator-watch.log"

# sync/watch 간격 (초)
SYNC_COOLDOWN_SEC="${SYNC_COOLDOWN_SEC:-45}"
POLL_INTERVAL_SEC="${POLL_INTERVAL_SEC:-10}"

log() { echo "[$(date +%H:%M:%S)] $*"; }

health_ok() { curl -sf "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; }

# 백엔드 기동/재기동 (pidfile 우선, pkill 폴백). 성공 0.
backend_restart() {
  if [ -f "$BACKEND_PIDFILE" ]; then
    kill "$(cat "$BACKEND_PIDFILE")" 2>/dev/null || true
    rm -f "$BACKEND_PIDFILE"
  fi
  pkill -f "node --experimental-sqlite src/server.js" 2>/dev/null || true
  sleep 1
  ( cd "$BACKEND_DIR" && PATH="$NODE_BIN:$PATH" \
      nohup node --experimental-sqlite src/server.js >> "$BACKEND_LOG" 2>&1 &
    echo $! > "$BACKEND_PIDFILE" )
  local i
  for i in $(seq 1 30); do
    health_ok && return 0
    sleep 1
  done
  return 1
}

# 단말이 device 상태인지
device_ready() { "$ADB" devices 2>/dev/null | grep -qE "^emulator-[0-9]+[[:space:]]+device$"; }

boot_completed() {
  [ "$("$ADB" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = "1" ]
}

# 위험 권한 사전 위임 (런타임 다이얼로그를 TCG에서 피하기 위해)
grant_permissions() {
  local pkg p
  for pkg in "$MASTER_PKG" "$SLAVE_PKG"; do
    for p in \
      android.permission.POST_NOTIFICATIONS \
      android.permission.ACCESS_COARSE_LOCATION \
      android.permission.ACCESS_FINE_LOCATION \
      android.permission.CAMERA \
      android.permission.BLUETOOTH_SCAN \
      android.permission.BLUETOOTH_CONNECT
    do
      "$ADB" shell pm grant "$pkg" "$p" 2>/dev/null || true
    done
  done
}

# 패키지 versionCode + 마지막 설치 시각 (동기 증빙용)
pkg_info() {
  "$ADB" shell dumpsys package "$1" 2>/dev/null \
    | grep -E "versionCode=|lastUpdateTime=" | head -2 | tr '\n' ' '
}
