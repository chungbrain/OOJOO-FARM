PORT=4000
HOST=0.0.0.0
DB_PATH=./data/oojoo.db

# ── FCM push (선택) — 둘 다 채워야 활성화, 미설정 시 no-op ──
# FCM_PROJECT_ID=oojoo-farm-123
# FCM_SERVICE_ACCOUNT=./firebase-service-account.json   # 또는 인라인 JSON 문자열
# (마스터 앱에는 FirebaseCfg.kt 에 google-services.json 값 추가 필요)

# ── 결제 게이트웨이 (선택) ──
# PG_MODE: 미설정|demo = 즉시 'paid' 데모 체크아웃 (기본), toss = Toss Payments 플로우
# PG_MODE=toss
# TOSS_SECRET_KEY=sk_test_...          # 결제 생성/확인 (서버사이드)
# TOSS_WEBHOOK_SECRET=whsec_...        # 포털 웹훅 서명 검증 (tss_v1)

# ── 로컬 model-manager 업로드·배포 토큰 — 설정해야 /api/models 업로드·배포가 열린다 (미설정 시 거부) ──
# 같은 값을 로컬 model-manager 설정(ml/model-manager/.local/config.json)의 업로드 토큰에 넣는다
# MODEL_MANAGER_TOKEN=<random 32+ chars>
